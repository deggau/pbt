{
  "name": "pbt",
  "version": "1.0.0",
  "description": "A web application to register and manage soccer team games, built with HTML, CSS, and JavaScript.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "db:inventory": "node scripts/inventory.js",
    "db:migrate": "node scripts/migrate.js",
    "db:apply-sql": "node scripts/apply-sql.js",
    "db:record": "node scripts/record-migration.js",
    "db:seed-demo": "node scripts/seed-demo.js",
    "db:account": "node scripts/account.js"
  },
  "keywords": [
    "soccer",
    "football",
    "game-registry"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.7"
  }
}
