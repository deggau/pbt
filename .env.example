# Conexão PostgreSQL do Supabase: somente no servidor/Secrets, nunca no frontend.
# Usar conexão direta ou pooler SESSION (porta 5432), com TLS validado.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
FRONTEND_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Definir apenas depois do inventário/revisão e backup restaurado:
# SCHEMA_REVIEWED=true
# BACKUP_VERIFIED=referencia-do-backup
